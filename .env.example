# ==============================================================================
# BounceBack SMS — Environment Variables (TEMPLATE)
# ==============================================================================
# Copy this file to ".env" and fill in real values. NEVER commit the real .env
# (it is gitignored). Keep secrets in your host's secret manager in production
# (Vercel project settings / AWS Secrets Manager).
# ==============================================================================

# ---- Core (REQUIRED to boot) -------------------------------------------------

# Postgres / Supabase connection string. Use the POOLED connection URL for
# serverless. Example: postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
DATABASE_URL=

# 64-char hex (256-bit) key. Encrypts customer phone numbers (AES-256-GCM).
# The app THROWS in production if this is missing. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Your live public app URL (no trailing slash). Used to build every Twilio &
# Stripe callback URL — must be correct or webhooks fail.
# Example: https://app.bouncebacksms.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Stripe (billing) --------------------------------------------------------

# Secret key. sk_test_... for staging, sk_live_... for production.
STRIPE_API_KEY=

# Signing secret for the webhook endpoint (/api/webhooks/stripe). whsec_...
# Get it from Stripe Dashboard > Developers > Webhooks > (your endpoint).
STRIPE_WEBHOOK_SECRET=

# ---- Twilio (calls / SMS) ----------------------------------------------------

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number used for outbound monthly-report SMS (E.164, e.g. +15125550100)
TWILIO_PHONE_NUMBER=

# ---- AI / Growth (optional features) -----------------------------------------

# Google Gemini — AI FrontDesk intake triage (/api/intake/process)
GEMINI_API_KEY=

# Google Places — Maps lead scraper (scripts/maps-scraper.ts). Billing enabled.
GOOGLE_PLACES_API_KEY=

# Resend — outreach email + magic-link login email
RESEND_API_KEY=
# Verified "From" address for magic-link emails (must be on your verified domain)
# Default: BounceBack SMS <login@bouncebacksms.com>
RESEND_FROM=

# ---- Auth --------------------------------------------------------------------
# Login is passwordless magic-link in production. In non-production it falls
# back to instant login so staging can be clicked through without email.
# Set to "true" to force instant login on a hosted staging env (NOT for prod).
ALLOW_DEV_LOGIN=

# Comma-separated warmed SMTP sending inboxes for outreach rotation
SMTP_FLEET=

# Firebase Cloud Messaging server key — push alerts to the mobile app
FCM_SERVER_KEY=

# ==============================================================================
# Notes:
#  - NODE_ENV and EXPORT_MODE are set by tooling/CI, not here.
#  - Staging: use TEST keys (sk_test_, Twilio trial creds). Production: LIVE keys.
#  - After editing env vars on the host, redeploy for changes to take effect.
# ==============================================================================
