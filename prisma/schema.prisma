// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  AGENCY
  USER
}

model Account {
  id                      String    @id @default(uuid())
  email                   String    @unique
  businessName            String
  realPhoneNumber         String    // User's actual phone line (AES-256-GCM encrypted at application layer)
  assignedTwilioNum       String?   @unique // Dynamically provisioned Twilio number
  bookingLink             String    // e.g., Calendly, Acuity, GlossGenius
  role                    Role      @default(USER)
  stripeCustomerId        String?   @unique
  stripePriceId           String?
  subscriptionStatus      String    @default("inactive") // active, trialing, past_due, inactive
  agencyId                String?
  agency                  Account?  @relation("AgencyToSubAccount", fields: [agencyId], references: [id])
  subAccounts             Account[] @relation("AgencyToSubAccount")
  aiFrontDeskEnabled      Boolean   @default(false)
  aiFrontDeskPriceMonthly Float     @default(29.99)

  // SwarmLeads $9.99 add-on entitlement (billed through BounceBack Stripe).
  swarmleadsAddonActive   Boolean   @default(false)
  swarmleadsAddonSince    DateTime?
  swarmleadsOutreach      SwarmleadsOutreach[]
  customLogoUrl           String?
  customBrandColor         String?
  smsTemplate             String?   @default("Hi, we missed your call. Here is our booking link to secure your spot: {booking_link}")
  intakeTickets           IntakeTicket[]
  
  // Privacy & Terms acceptance tracking with versioning
  privacyAccepted         Boolean   @default(false)
  privacyAcceptedAt       DateTime?
  privacyPolicyVersion    String?   // Tracks which version of the Privacy Policy was accepted (e.g., "2026-06-17-v1")
  termsAccepted           Boolean   @default(false)
  termsAcceptedAt         DateTime?
  termsVersion            String?   // Tracks which version of the Terms & Conditions was accepted (e.g., "2026-06-17-v1")
  
  createdAt               DateTime  @default(now())
  logs                    CallLog[]
  a2pRegistration         A2pRegistration?

  // A2P 10DLC compliance registration fields
  a2pLegalBusinessName    String?
  a2pBusinessType         String?
  a2pEinOrTaxId           String?
  a2pWebsiteUrl           String?
  a2pCampaignUseCase      String?
  a2pSampleMessages       String?
  a2pRegistrationStatus   String?   @default("unregistered")
  a2pTwilioBrandSid       String?
  a2pTwilioCampaignSid     String?
  a2pPrivacyPolicyUrl     String?
  a2pTermsOfServiceUrl    String?
}

enum SwarmleadsOutreachStatus {
  QUEUED
  SENT
  FAILED
}

// Landing table for phone leads pushed from SwarmLeads' outreach queue.
// Kept separate from the reactive Twilio CallLog flow; dispatch is Phase 3.
model SwarmleadsOutreach {
  id           String                   @id @default(uuid())
  accountId    String
  account      Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  phone        String // AES-256-GCM encrypted at application layer
  businessName String?
  metadata     Json?
  status       SwarmleadsOutreachStatus @default(QUEUED)
  createdAt    DateTime                 @default(now())

  @@index([accountId])
  @@index([status])
}

model LeadToken {
  id        String   @id @default(uuid())
  token     String   @unique
  ticketId  String
  ticket    IntakeTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model CallLog {
  @@index([accountId])
  @@index([timestamp])
  id              String   @id @default(uuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  callerNumber    String   // AES-256-GCM encrypted at application layer
  callStatus      String   // busy, no-answer, completed
  smsSent         Boolean  @default(false)
  revenueSavedEst Float    @default(0.0) // Auto-calculated based on a standard local service value ($60.00)
  timestamp       DateTime @default(now())
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DispatchStatus {
  PENDING
  SYNCED
  FAILED
}

enum LeadStatus {
  NEW
  QUOTED
  BOOKED
  LOST
}

model IntakeTicket {
  id              String         @id @default(uuid())
  accountId       String
  account         Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerName    String
  customerPhone   String         // AES-256-GCM encrypted at application layer
  emergencyIssue  String
  issueSummary    String?        // Filled by AI
  computedUrgency UrgencyLevel   @default(LOW) // Rated by AI
  isBooked        Boolean        @default(false)
  dispatchStatus  DispatchStatus @default(PENDING)
  status          LeadStatus     @default(NEW)
  notes           String?
  activities      LeadActivity[]
  leadTokens      LeadToken[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([accountId])
}

model LeadActivity {
  id           String       @id @default(uuid())
  ticketId     String
  ticket       IntakeTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  activityType String       // e.g. "CREATED", "SMS_SENT", "STATUS_CHANGED", "NOTE_ADDED"
  content      String
  createdAt    DateTime     @default(now())

  @@index([ticketId])
  @@index([createdAt])
}


enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model ScrapeState {
  id                   String   @id @default(uuid())
  currentIndustryIndex Int      @default(0)
  currentCityIndex     Int      @default(0)
  lastRunTimestamp     DateTime @default(now())
  isActive             Boolean  @default(true)
}

model EmailHoldingTank {
  id                   String      @id @default(uuid())
  businessName         String
  emailAddress         String
  industry             String
  city                 String
  estimatedRevenueLoss Float
  status               EmailStatus @default(PENDING)
  dispatchedFromInbox  String?
  createdAt            DateTime    @default(now())
}

// Persistent login sessions (replaces the old in-memory session store so
// logins survive server restarts and work across serverless instances).
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  accountId String
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([accountId])
}

// One-time, short-lived tokens emailed for passwordless "magic link" sign-in.
model LoginToken {
  id        String    @id @default(uuid())
  token     String    @unique
  accountId String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  // When set, verify redirects here with a signed SwarmLeads user JWT instead
  // of establishing a BounceBack session (cross-app unified login).
  returnTo  String?
  createdAt DateTime  @default(now())

  @@index([token])
}

model A2pRegistration {
  id                  String   @id @default(uuid())
  accountId           String   @unique
  account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  legalBusinessName   String
  ein                 String
  businessType        String
  industry            String
  website             String
  country             String
  address             String
  contactFirstName    String
  contactLastName     String
  contactEmail        String
  contactPhone        String
  campaignDescription String
  sampleMessage1      String
  sampleMessage2      String
  status              String   @default("PENDING") // PENDING, APPROVED, REJECTED
  privacyPolicyUrl      String   // Required by Twilio A2P 10DLC as of June 2026
  termsAndConditionsUrl String   // Required by Twilio A2P 10DLC as of June 2026
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
